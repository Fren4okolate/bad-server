PORT=3000
DB_ADDRESS=mongodb://127.0.0.1:27017/weblarek
ORIGIN_ALLOW=http://localhost:5173,http://localhost
UPLOAD_PATH=images
UPLOAD_PATH_TEMP=temp
AUTH_REFRESH_TOKEN_EXPIRY=7d
AUTH_ACCESS_TOKEN_EXPIRY=10m
# In production all three independent secrets are required (at least 32 characters).
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_ACCESS_TOKEN_SECRET=
# AUTH_REFRESH_TOKEN_SECRET=
# SESSION_SECRET=
# HTTP localhost uses false; enable true for deployment with HTTPS.
COOKIE_SECURE=false
# 1 only behind nginx with no direct access to backend; 0 for local development.
TRUST_PROXY=0
